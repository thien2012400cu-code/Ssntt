-- --- NÚT ĐIỀU KHIỂN MENU ---
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 50, 0, 50); ToggleBtn.Position = UDim2.new(0, 20, 0.4, 0)
ToggleBtn.Text = "MENU"; ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 12)
local dragging, dragStart, startPos
ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = ToggleBtn.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        ToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
ToggleBtn.InputEnded:Connect(function() dragging = false end)
ToggleBtn.MouseButton1Click:Connect(function() Window:Toggle() end)

-- --- BIẾN HỆ THỐNG ---
local LP = game:GetService("Players").LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

_G.WS = 16; _G.TweenSpeed = 60
_G.KillAura = false; _G.AutoMine = false; _G.AutoBag = false; _G.TweenItem = false
_G.ItemESP = false; _G.ZombieESP = false; _G.PlayerESP = false; _G.ChestESP = false
_G.InfJump = false; _G.InstantInteract = false; _G.TPWall = false; _G.FullBright = false

-- --- HÀM TÌM REMOTE NHẶT ĐỒ ---
local function GetLootRemote()
    return RS:FindFirstChild("AdjustBackpack", true)
end

-- --- HÀM TẠO ESP ---
local function CreateESP(obj, text, color)
    pcall(function()
        if not obj or obj:FindFirstChild("Gemini_ESP") then return end
        local bbg = Instance.new("BillboardGui", obj); bbg.Name = "Gemini_ESP"; bbg.AlwaysOnTop = true; bbg.Size = UDim2.new(0, 100, 0, 25); bbg.StudsOffset = Vector3.new(0, 2, 0)
        local txt = Instance.new("TextLabel", bbg); txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.Text = text; txt.TextColor3 = color; txt.Font = "SourceSansBold"; txt.TextSize = 11
    end)
end

-- ================= TÍNH NĂNG =================

local MainTab = Window:Tab({ Title = "Người Chơi", Icon = "user" })
MainTab:Slider({ Title = "Tốc độ chạy", Min = 16, Max = 250, Default = 16, Callback = function(v) _G.WS = v end})
MainTab:Toggle({ Title = "Nhảy vô hạn", Default = false, Callback = function(v) _G.InfJump = v end})
MainTab:Toggle({ Title = "Xuyên tường an toàn", Default = false, Callback = function(v) _G.TPWall = v end})

local CombatTab = Window:Tab({ Title = "Chiến Đấu", Icon = "swords" })
CombatTab:Toggle({ Title = "Tự động đánh", Default = false, Callback = function(v) _G.KillAura = v
    task.spawn(function() while _G.KillAura do pcall(function()
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, t in pairs(workspace.Characters:GetChildren()) do
                local hum = t:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 and t ~= LP.Character and (LP.Character.HumanoidRootPart.Position - t.HumanoidRootPart.Position).Magnitude < 18 then
                    tool.Swing:FireServer(); tool.HitTargets:FireServer({t})
                end
            end
        end end) task.wait(0.1) end end)
end})
CombatTab:Toggle({ Title = "Tự động đào", Default = false, Callback = function(v) _G.AutoMine = v
    task.spawn(function() while _G.AutoMine do pcall(function()
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, s in pairs(workspace.Structures:GetChildren()) do
                if (LP.Character.HumanoidRootPart.Position - s:GetModelCFrame().p).Magnitude < 16 then
                    tool.Swing:FireServer(); tool.HitTargets:FireServer({s})
                end
            end
        end end) task.wait(0.2) end end)
end})

local LootTab = Window:Tab({ Title = "Nhặt Đồ", Icon = "package" })
LootTab:Toggle({ Title = "Tự nhặt gần", Default = false, Callback = function(v) _G.AutoBag = v
    task.spawn(function() while _G.AutoBag do pcall(function()
        local remote = GetLootRemote()
        if remote then
            for _, i in pairs(workspace.DroppedItems:GetChildren()) do
                if (LP.Character.HumanoidRootPart.Position - i.Position).Magnitude < 25 then 
                    remote:FireServer(i) 
                end
            end
        end end) task.wait(0.2) end end)
end})
LootTab:Toggle({ Title = "Tự bay nhặt đồ", Default = false, Callback = function(v) _G.TweenItem = v
    task.spawn(function() while _G.TweenItem do pcall(function()
        local remote = GetLootRemote()
        for _, i in pairs(workspace.DroppedItems:GetChildren()) do
            if not _G.TweenItem then break end
            local tw = TS:Create(LP.Character.HumanoidRootPart, TweenInfo.new((LP.Character.HumanoidRootPart.Position - i.Position).Magnitude/_G.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = i.CFrame * CFrame.new(0,1.5,0)})
            tw:Play(); tw.Completed:Wait(); task.wait(0.2); if remote then remote:FireServer(i) end
        end end) task.wait(0.5) end end)
end})

local ESPTab = Window:Tab({ Title = "Hiển Thị", Icon = "eye" })
ESPTab:Toggle({ Title = "Hiện rương vàng", Default = false, Callback = function(v) _G.ChestESP = v; if not v then 
    for _,v in pairs(workspace:GetDescendants()) do if v.Name == "Gemini_ESP" then v:Destroy() end end end
    task.spawn(function() while _G.ChestESP do pcall(function()
        local chestRoot = workspace.Map.Tiles:GetChildren()[72].Assets:GetChildren()[59]
        if chestRoot then for _, c in pairs(chestRoot:GetChildren()) do CreateESP(c, "RƯƠNG VÀNG", Color3.fromRGB(255, 215, 0)) end end
    end) task.wait(5) end end)
end})
ESPTab:Toggle({ Title = "Hiện quái", Default = false, Callback = function(v) _G.ZombieESP = v
    task.spawn(function() while _G.ZombieESP do pcall(function()
        for _, z in pairs(workspace.Characters:GetChildren()) do 
            if z ~= LP.Character and not game.Players:GetPlayerFromCharacter(z) then CreateESP(z, "QUÁI", Color3.fromRGB(255, 0, 0)) end 
        end end) task.wait(5) end end)
end})
ESPTab:Toggle({ Title = "Hiện người chơi", Default = false, Callback = function(v) _G.PlayerESP = v
    task.spawn(function() while _G.PlayerESP do pcall(function()
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= LP and p.Character then CreateESP(p.Character.Head, p.DisplayName, Color3.fromRGB(255, 255, 255)) end
        end end) task.wait(5) end end)
end})

local TPTab = Window:Tab({ Title = "Dịch Chuyển", Icon = "map-pin" })
TPTab:Button({ Title = "Về nhà an toàn (Void)", Callback = function()
    pcall(function() LP.Character.HumanoidRootPart.CFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(0, -500, 0) end)
end})

local WorldTab = Window:Tab({ Title = "Thế Giới", Icon = "globe" })
WorldTab:Toggle({ Title = "Luôn luôn sáng", Default = false, Callback = function(v) _G.FullBright = v end})
WorldTab:Toggle({ Title = "Tương tác nhanh", Default = false, Callback = function(v) _G.InstantInteract = v end})
WorldTab:Button({ Title = "Xóa sương mù", Callback = function()
